{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "VoiceWatchdog": {
    "IntervalSeconds": 5
  },
  "VoiceActivity": {
    "ProjectionIntervalSeconds": 20,
    "MaximumSegmentsPerDocument": 2000,
    "ProjectionBatchSize": 100,
    "MigrationBatchSize": 500,
    "MaxWriteAttempts": 8
  },
  "VoiceLedgerMigration": {
    "DeleteBatchSize": 50,
    "MaxRetries": 8,
    "RetryDelaySeconds": 30,
    "IdleDelaySeconds": 60
  },
  "AnalyticsRetention": {
    "HourDays": 30,
    "DayDays": 400
  },
  "ReportingRetention": {
    "AuditDays": 180,
    "OccurrenceDays": 30,
    "IncidentDays": 180
  },
  "MongoDb": {
    "ConnectionString": "${MONGODB_CONNECTION_STRING}",
    "DatabaseName": "${MONGODB_DATABASE_NAME}"
  },
  "Discord": {
    "ClientId": "${DISCORD_CLIENT_ID}",
    "ClientSecret": "${DISCORD_CLIENT_SECRET}",
    "BotToken": "${DISCORD_BOT_TOKEN}",
    "BotInvitePermissions": "285305936",
    "RedirectUri": "${DISCORD_REDIRECT_URI}",
    "Scopes": ["identify", "email", "guilds"]
  },
  "Jwt": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "Rankoon",
    "Audience": "RankoonUsers",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  },
  "Frontend": {
    "BaseUrl": "${FRONTEND_BASE_URL}",
    "CallbackPath": "/auth/callback"
  }
}
