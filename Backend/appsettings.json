{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "DataProtection": {
    "KeyRingPath": ""
  },
  "RateLimiting": {
    "RejectionRetryAfterSeconds": 60,
    "TrustedProxyIps": [],
    "Leaderboard": { "PermitLimit": 90, "WindowSeconds": 60, "QueueLimit": 2 },
    "Reports": { "PermitLimit": 60, "WindowSeconds": 60, "QueueLimit": 2 },
    "BotManagement": { "PermitLimit": 30, "WindowSeconds": 60, "QueueLimit": 2 },
    "OAuthLogin": { "PermitLimit": 10, "WindowSeconds": 60, "QueueLimit": 0 },
    "OAuthCallback": { "PermitLimit": 10, "WindowSeconds": 60, "QueueLimit": 0 },
    "OAuthRefresh": { "PermitLimit": 12, "WindowSeconds": 60, "QueueLimit": 0 },
    "OAuthLogout": { "PermitLimit": 12, "WindowSeconds": 60, "QueueLimit": 0 },
    "CustomBotValidation": { "PermitLimit": 6, "WindowSeconds": 60, "QueueLimit": 0, "ConcurrencyLimit": 1 },
    "CustomBotSave": { "PermitLimit": 6, "WindowSeconds": 60, "QueueLimit": 0, "ConcurrencyLimit": 1 },
    "CustomBotActivate": { "PermitLimit": 3, "WindowSeconds": 60, "QueueLimit": 0, "ConcurrencyLimit": 1 },
    "CustomBotRestart": { "PermitLimit": 3, "WindowSeconds": 60, "QueueLimit": 0, "ConcurrencyLimit": 1 },
    "XpImport": { "PermitLimit": 3, "WindowSeconds": 60, "QueueLimit": 0, "ConcurrencyLimit": 1 },
    "XpSettings": { "PermitLimit": 10, "WindowSeconds": 60, "QueueLimit": 0, "ConcurrencyLimit": 1 }
  },
  "VoiceWatchdog": {
    "ReconciliationIntervalSeconds": 60,
    "ShutdownTimeoutSeconds": 20
  },
  "CustomBotIdentity": {
    "MaxConcurrentRuntimes": 10,
    "RuntimeStartQueueCapacity": 20,
    "RuntimeStartRetries": 2,
    "RuntimeRetryDelaySeconds": 2,
    "RuntimeShutdownTimeoutSeconds": 20,
    "DownloadAllMembers": false
  },
  "VoiceActivity": {
    "CheckpointIntervalSeconds": 30,
    "MaximumCheckpointBatchSize": 250,
    "MaximumBatchDelayMilliseconds": 1000,
    "ProjectionIntervalSeconds": 30,
    "MaximumSegmentsPerDocument": 2000,
    "ProjectionBatchSize": 100,
    "MigrationBatchSize": 500,
    "MaxWriteAttempts": 8,
    "RuntimeWatermarkIntervalSeconds": 5,
    "MaximumRecoveryGapSeconds": 35
  },
  "VoiceLedgerMigration": {
    "DeleteBatchSize": 50,
    "MaxRetries": 8,
    "RetryDelaySeconds": 30,
    "IdleDelaySeconds": 60
  },
  "MongoStartupMaintenance": {
    "RepairBatchSize": 100
  },
  "AnalyticsRetention": {
    "HourDays": 30,
    "DayDays": 400
  },
  "ReportingRetention": {
    "AuditDays": 180,
    "OccurrenceDays": 30,
    "IncidentDays": 180
  },
  "MongoDb": {
    "ConnectionString": "${MONGODB_CONNECTION_STRING}",
    "DatabaseName": "${MONGODB_DATABASE_NAME}"
  },
  "Discord": {
    "ClientId": "${DISCORD_CLIENT_ID}",
    "ClientSecret": "${DISCORD_CLIENT_SECRET}",
    "BotToken": "${DISCORD_BOT_TOKEN}",
    "BotInvitePermissions": "285305936",
    "RedirectUri": "${DISCORD_REDIRECT_URI}",
    "Scopes": ["identify", "email", "guilds"]
  },
  "Jwt": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "Rankoon",
    "Audience": "RankoonUsers",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  },
  "AuthCookies": {
    "AccessCookieName": "__Host-rankoon-access",
    "RefreshCookieName": "__Host-rankoon-refresh",
    "CsrfHeaderName": "X-CSRF-TOKEN",
    "Secure": true,
    "SameSite": "Strict"
  },
  "Frontend": {
    "BaseUrl": "${FRONTEND_BASE_URL}",
    "CallbackPath": "/auth/callback"
  }
}
