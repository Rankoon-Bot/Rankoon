# MongoDB
MONGODB_CONNECTION_STRING=mongodb://localhost:27017
MONGODB_DATABASE_NAME=rankoon

# Discord OAuth and bot configuration
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_REDIRECT_URI=http://localhost:5020/api/auth/callback

# JWT signing key. Use a long, random value in real environments.
JWT_SECRET_KEY=replace_with_a_long_random_secret_key

# Frontend URL allowed by the backend CORS policy
FRONTEND_BASE_URL=http://localhost:4200

# Global voice XP reconciliation interval. Overrides VoiceWatchdog:IntervalSeconds.
VOICEWATCHDOG__INTERVALSECONDS=5
VOICEACTIVITY__PROJECTIONINTERVALSECONDS=20
VOICEACTIVITY__MAXIMUMSEGMENTSPERDOCUMENT=2000
VOICEACTIVITY__PROJECTIONBATCHSIZE=100
VOICEACTIVITY__MIGRATIONBATCHSIZE=500
VOICEACTIVITY__MAXWRITEATTEMPTS=8

# Optional legacy voice-ledger migration overrides and deletion/retry controls.
# VOICELEDGERMIGRATION__COPYBATCHSIZE=500
VOICELEDGERMIGRATION__DELETEBATCHSIZE=50
VOICELEDGERMIGRATION__MAXRETRIES=8
VOICELEDGERMIGRATION__RETRYDELAYSECONDS=30
VOICELEDGERMIGRATION__IDLEDELAYSECONDS=60

# Analytics, audit, error occurrence, and incident retention in days.
ANALYTICSRETENTION__HOURDAYS=30
ANALYTICSRETENTION__DAYDAYS=400
REPORTINGRETENTION__AUDITDAYS=180
REPORTINGRETENTION__OCCURRENCEDAYS=30
REPORTINGRETENTION__INCIDENTDAYS=180

# Custom Bot Identity. Keep disabled unless the Data Protection key ring is persistent.
CUSTOMBOTIDENTITY__ENABLED=false
CUSTOMBOTIDENTITY__MAXACTIVEGUILDS=10
CUSTOMBOTIDENTITY__FINGERPRINTKEY=replace_with_a_separate_long_random_secret
CUSTOMBOTIDENTITY__STARTUPPARALLELISM=2
# CUSTOMBOTIDENTITY__ALLOWEDGUILDIDS__0=123456789012345678
# CUSTOMBOTIDENTITY__ALLOWEDGUILDIDS__1=234567890123456789

# Required outside Development. Mount this directory persistently; it must be outside /app and writable by the container user.
# Changing, losing, or replacing this key ring makes stored custom-bot tokens unreadable.
DATAPROTECTION__KEYRINGPATH=/var/lib/rankoon/data-protection-keys

# The development redirect URI is configured in appsettings.Development.json:
# http://localhost:5020/api/auth/callback
